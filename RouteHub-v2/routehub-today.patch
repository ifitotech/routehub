+'use client'
+import {useEffect} from 'react'
+import {syncQueue} from '../../lib/offline-queue'
+import {completeMission} from '../../lib/data'
+import {uploadMissionEvidence} from '../../lib/mission-evidence'
+
+export default function OfflineQueueSync(){
+  useEffect(()=>{
+    const flush=()=>void syncQueue(async action=>{
+      const p=action.payload as any
+      if(action.kind==='complete'){
+        const result=await completeMission(p.routeId,p.location||undefined,p.driverNote===null?undefined:{driverNote:p.driverNote})
+        if(!result)throw new Error('Unable to sync completion')
+      }else if(action.kind==='photo'){
+        const bytes=atob(String(p.data).split(',')[1]||'')
+        const file=new File([Uint8Array.from(bytes,c=>c.charCodeAt(0))],p.name||'evidence.jpg',{type:p.type||'image/jpeg'})
+        await uploadMissionEvidence(file,p.routeId)
+      }
+    })
+    window.addEventListener('online',flush); flush()
+    return()=>window.removeEventListener('online',flush)
+  },[])
+  return null
+}
