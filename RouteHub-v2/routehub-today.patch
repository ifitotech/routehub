+'use client'
+
+import {useEffect, useState} from 'react'
+import {usePathname, useRouter} from 'next/navigation'
+import {getSupabase} from '../../lib/supabase'
+import {resolveAccess} from '../auth-access'
+
+export default function DriverConsentGate({children}: {children: React.ReactNode}) {
+  const pathname = usePathname()
+  const router = useRouter()
+  const [ready, setReady] = useState(false)
+
+  useEffect(() => {
+    let cancelled = false
+    const check = async () => {
+      if (pathname?.startsWith('/driver-v3/consent')) { setReady(true); return }
+      try {
+        const client = getSupabase()
+        const access = await resolveAccess(client)
+        if (access.role !== 'driver') { setReady(true); return }
+        const {data, error} = await client.from('company_users')
+          .select('company_id,gps_consent_accepted_at')
+          .eq('user_id', access.user.id).eq('role', 'driver').limit(1).maybeSingle()
+        if (error) throw error
+        if (!data?.gps_consent_accepted_at) { router.replace('/driver-v3/consent'); return }
+        if (!cancelled) setReady(true)
+      } catch { if (!cancelled) router.replace('/login') }
+    }
+    void check()
+    return () => { cancelled = true }
+  }, [pathname, router])
+
+  if (!ready) return <div className="driver-v3-splash" role="status" aria-live="polite"><strong>RouteHub Driver</strong><p>Opening your workspace…</p><div className="spin" aria-hidden="true" /></div>
+  return <>{children}</>
+}
