@@ -0,0 +1,13 @@
+'use client'
+import {useEffect} from 'react'
+import {captureSentryError} from '../lib/sentry'
+
+export default function ErrorMonitor() {
+  useEffect(() => {
+    const onError = (event: ErrorEvent) => captureSentryError({error: event.error || event.message, action: 'window_error', context: {source: window.location.pathname}})
+    const onRejection = (event: PromiseRejectionEvent) => captureSentryError({error: event.reason, action: 'unhandled_rejection', context: {source: window.location.pathname}})
+    window.addEventListener('error', onError); window.addEventListener('unhandledrejection', onRejection)
+    return () => { window.removeEventListener('error', onError); window.removeEventListener('unhandledrejection', onRejection) }
+  }, [])
+  return null
+}
