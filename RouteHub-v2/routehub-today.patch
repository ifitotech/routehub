+export function captureSentryError(error: unknown, action: string, context: Record<string, unknown> = {}) {
+  const dsn = Deno.env.get('SENTRY_DSN')
+  if (!dsn) return
+  try {
+    const parsed = new URL(dsn); const project = parsed.pathname.replace(/^\//, ''); const key = parsed.username
+    const endpoint = `${parsed.protocol}//${parsed.host}/api/${project}/store/`
+    const message = error instanceof Error ? error.message : String(error || 'Unknown error')
+    void fetch(endpoint, {method: 'POST', headers: {'Content-Type': 'application/json', 'X-Sentry-Auth': `Sentry sentry_version=7, sentry_key=${key}, sentry_client=routehub-edge/1.0`}, body: JSON.stringify({message: message.slice(0, 500), level: 'error', platform: 'javascript', tags: {action}, extra: context})}).catch(() => undefined)
+  } catch { /* optional monitoring must never break an Edge Function */ }
+}
