diff --git a/RouteHub-v2/lib/sentry.ts b/RouteHub-v2/lib/sentry.ts
new file mode 100644
index 0000000..48c7643
--- /dev/null
+++ b/RouteHub-v2/lib/sentry.ts
@@ -0,0 +1,17 @@
+type SentryErrorInput = {error: unknown; action?: string; context?: Record<string, unknown>}
+
+function messageOf(error: unknown) { return error instanceof Error ? error.message : String(error || 'Unknown error') }
+
+/** Optional, dependency-free Sentry reporting. It is a no-op until a DSN is configured. */
+export function captureSentryError({error, action = 'unhandled_error', context = {}}: SentryErrorInput) {
+  const dsn = typeof window === 'undefined' ? process.env.SENTRY_DSN : process.env.NEXT_PUBLIC_SENTRY_DSN
+  if (!dsn || typeof fetch === 'undefined') return
+  try {
+    const parsed = new URL(dsn)
+    const projectId = parsed.pathname.replace(/^\//, '')
+    const publicKey = parsed.username
+    const endpoint = `${parsed.protocol}//${parsed.host}/api/${projectId}/store/`
+    const payload = {message: messageOf(error).slice(0, 500), level: 'error', platform: 'javascript', tags: {action}, extra: context}
+    void fetch(endpoint, {method: 'POST', headers: {'Content-Type': 'application/json', 'X-Sentry-Auth': `Sentry sentry_version=7, sentry_key=${publicKey}, sentry_client=routehub/1.0`}, body: JSON.stringify(payload), keepalive: true}).catch(() => undefined)
+  } catch { /* malformed or disabled DSN must never affect the app */ }
+}
