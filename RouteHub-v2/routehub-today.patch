uteStatusGrid span{grid-column:1/-1;overflow:hidden;margin-top:6px;color:#667892;font-size:9px;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.statusActive{background:#315eea}.statusPending{background:#f6aa34}.statusCompleted{background:#20b76a}.statusIssue{background:#e74444}.stopPreview{margin-top:18px;padding-top:15px;border-top:1px solid #e8eef4}.stopPreview>div{display:flex;align-items:center;justify-content:space-between;gap:12px}.stopPreview h3{margin:0;color:#14233b;font-size:14px}.stopPreview span{padding:5px 8px;border-radius:999px;background:#f1f5fb;color:#64748b;font-size:10px;font-weight:800;white-space:nowrap}.stopPreview p{overflow:hidden;margin:10px 0 0;color:#667892;font-size:12px;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}
