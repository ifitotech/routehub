+alter table public.company_users
+  add column if not exists gps_consent_accepted_at timestamptz;
+
+comment on column public.company_users.gps_consent_accepted_at is
+  'Fecha/hora en que el usuario aceptó el aviso de rastreo GPS. Null = no ha aceptado.';
+
+-- Keep the write narrow and auditable: a driver can consent only for their
+-- own membership in the selected company.
+create or replace function public.accept_gps_consent(target_company_id uuid)
+returns timestamptz
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare accepted_at timestamptz;
+begin
+  update public.company_users
+     set gps_consent_accepted_at = now()
+   where company_id = target_company_id
+     and user_id = auth.uid()
+     and role = 'driver'
+   returning gps_consent_accepted_at into accepted_at;
+  if accepted_at is null then
+    raise exception 'No driver membership found for this company';
+  end if;
+  return accepted_at;
+end;
+$$;
+
+revoke all on function public.accept_gps_consent(uuid) from public;
+grant execute on function public.accept_gps_consent(uuid) to authenticated;
