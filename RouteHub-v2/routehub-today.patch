+export type PendingAction={id:string;kind:'complete'|'issue'|'photo';payload:Record<string,unknown>;createdAt:string}
+const DB='routehub-offline', STORE='actions', FALLBACK='routehub-v2-offline-queue'
+const indexed=()=>typeof indexedDB!=='undefined'
+const openDb=():Promise<IDBDatabase>=>new Promise((resolve,reject)=>{const req=indexedDB.open(DB,1);req.onupgradeneeded=()=>req.result.createObjectStore(STORE,{keyPath:'id'});req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)})
+export async function readQueue():Promise<PendingAction[]>{
+  if(typeof window==='undefined')return[]
+  if(!indexed())try{return JSON.parse(localStorage.getItem(FALLBACK)||'[]')}catch{return[]}
+  try{const db=await openDb();return await new Promise((resolve,reject)=>{const req=db.transaction(STORE,'readonly').objectStore(STORE).getAll();req.onsuccess=()=>resolve((req.result||[]) as PendingAction[]);req.onerror=()=>reject(req.error)})}catch{return[]}
+}
+export async function enqueue(action:Omit<PendingAction,'id'|'createdAt'>){if(typeof window==='undefined')return;const next={...action,id:crypto.randomUUID(),createdAt:new Date().toISOString()};if(!indexed()){localStorage.setItem(FALLBACK,JSON.stringify([...(await readQueue()),next]));return}const db=await openDb();await new Promise<void>((resolve,reject)=>{const req=db.transaction(STORE,'readwrite').objectStore(STORE).add(next);req.onsuccess=()=>resolve();req.onerror=()=>reject(req.error)})}
