diff --git a/RouteHub-v2/supabase/migrations/046_atomic_activation_attempts.sql b/RouteHub-v2/supabase/migrations/046_atomic_activation_attempts.sql
new file mode 100644
index 0000000..ed442e6
--- /dev/null
+++ b/RouteHub-v2/supabase/migrations/046_atomic_activation_attempts.sql
@@ -0,0 +1,28 @@
+-- Atomically consume an activation attempt so concurrent requests cannot
+-- bypass the five-attempt limit by reading the same counter.
+create or replace function public.consume_activation_attempt(
+  p_invitation_id uuid,
+  p_code_hash text
+)
+returns boolean
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  matched boolean;
+begin
+  update public.invitations
+     set activation_attempts = activation_attempts + 1
+   where id = p_invitation_id
+     and status = 'pending'
+     and activation_code_used_at is null
+     and activation_attempts < 5
+  returning activation_code_hash = p_code_hash into matched;
+
+  return coalesce(matched, false);
+end;
+$$;
+
+revoke all on function public.consume_activation_attempt(uuid, text) from public;
+grant execute on function public.consume_activation_attempt(uuid, text) to service_role;
