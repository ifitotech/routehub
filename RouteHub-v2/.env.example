NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Browser-restricted key for Maps JavaScript + Places (HTTP referrers).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Server-only key for Routes + Geocoding APIs. Never expose this to the browser.
GOOGLE_MAPS_SERVER_KEY=
# Leave false while testing Pro. Set true at launch to enforce:
# Basic = Simple + phone navigation; Premium/Pro/trial = Pro + in-app navigation.
NEXT_PUBLIC_DRIVER_PREMIUM_ENFORCEMENT=false
